# COPY THIS FILE TO ".env" AND PUT YOUR REAL KEY IN THE COPY.
# The copy is ignored by git. This example file is safe to share.
#
#   cp .env.example .env
#
# You only need ONE of these. Delete the lines you are not using.

# OPENAI_API_KEY = "sk-..."
# GEMINI_API_KEY = "..."
# GROQ_API_KEY   = "gsk_..."
# NVIDIA_API_KEY = "nvapi-..."

# Which provider to try first. Optional.
# LLM_PROVIDER = "groq"

# Override a model name without editing the code. Optional.
# GROQ_MODEL = "openai/gpt-oss-120b"

# ── Admin login for the Blueprint/admin view ──
# The app reads these from the environment. If unset it falls back to
# admin / secret — fine for a demo, NOT for anything real. Set your own,
# and never reuse a password like "123456789".
# ADMIN_USERNAME = "changeme"
# ADMIN_PASSWORD = "use-a-long-random-passphrase"
