# COPY THIS FILE TO ".env" AND PUT YOUR REAL KEY IN THE COPY.
# The copy is ignored by git. This example file is safe to share.
#
#   cp .env.example .env
#
# You only need ONE of these. Delete the lines you are not using.

# OPENAI_API_KEY = "sk-..."
# GEMINI_API_KEY = "..."
# GROQ_API_KEY   = "gsk_..."
# NVIDIA_API_KEY = "nvapi-..."
# ELEVENLABS_API_KEY = "sk_..."

# Voicebox (github.com/jamiepine/voicebox) — free, self-hosted, local-first
# TTS alternative to ElevenLabs. English-only via its API (no Kwéyòl/French/
# Spanish). Needs its own separate Docker deployment (its MCP server is
# desktop-app-only and can't be reached from a cloud-deployed bot — the
# Docker image's plain REST API is the only way in from Render). Create a
# voice profile via that instance's own web UI first to get the profile id.
# Its API has NO built-in auth — deploy it as a Render Private Service (no
# public URL, reachable only from other services on this Render account) so
# nothing external can hit it unauthenticated. From a Private Service the
# URL is "http://<render-service-name>:17493" — not a public https:// host.
# VOICEBOX_API_URL = "http://voicebox:17493"
# VOICEBOX_PROFILE_ID = "..."

# Which provider to try first. Optional.
# LLM_PROVIDER = "groq"

# Override a model name without editing the code. Optional.
# GROQ_MODEL = "openai/gpt-oss-120b"

# ── Admin login for the Blueprint/admin view ──
# The app reads these from the environment. If unset it falls back to
# admin / secret — fine for a demo, NOT for anything real. Set your own,
# and never reuse a password like "123456789".
# ADMIN_USERNAME = "changeme"
# ADMIN_PASSWORD = "use-a-long-random-passphrase"

# Optional SMTP settings for two-step admin login verification codes.
# If these are not set, the app shows the generated code in the UI for local/demo testing.
# SMTP_HOST = "smtp.example.com"
# SMTP_PORT = "587"
# SMTP_USERNAME = "mailer@example.com"
# SMTP_PASSWORD = "replace-with-app-password"
# SMTP_FROM_EMAIL = "LUCELEC Admin <mailer@example.com>"
# SMTP_USE_TLS = "true"
